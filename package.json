{
  "name": "w3rk-net",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/build-sw.mjs && vite build",
    "start": "vite preview",
    "lint": "tsc --noEmit",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:ci": "playwright test --reporter=github",
    "test:user-flows": "playwright test tests/user-flows.spec.ts",
    "build:test": "npm run build && npm run test:ci",
    "deploy:check": "npm run typecheck && npm run test:unit && npm run build && wrangler deploy --dry-run",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:deploy": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "deploy": "wrangler deploy",
    "cf:types": "wrangler types",
    "data:transfer": "node scripts/transfer-data.mjs"
  },
  "dependencies": {
    "@farcaster/miniapp-sdk": "0.1.10",
    "@xmtp/browser-sdk": "4.1.0",
    "@xmtp/content-type-text": "2.0.2",
    "ethers": "6.15.0",
    "next-auth": "4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "siwe": "2.3.2",
    "thirdweb": "5.105.41",
    "viem": "2.37.3",
    "vinext": "1.1.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@cloudflare/vite-plugin": "1.63.1",
    "@electric-sql/pglite": "0.5.9",
    "@openzeppelin/contracts": "5.4.0",
    "@playwright/test": "1.55.0",
    "@types/node": "22.19.15",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "eslint": "8.57.0",
    "miniflare": "5.20261006.1-alpha",
    "next": "16.3.1",
    "pg": "8.16.3",
    "truffle-flattener": "1.6.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  }
}
