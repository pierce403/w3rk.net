{
  "name": "w3rk-net",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/build-sw.mjs && vite build",
    "start": "vite preview",
    "lint": "tsc --noEmit",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:ci": "playwright test --reporter=github",
    "test:user-flows": "playwright test tests/user-flows.spec.ts",
    "build:test": "npm run build && npm run test:ci",
    "deploy:check": "npm run typecheck && npm run test:unit && npm run build && wrangler deploy --dry-run",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:deploy": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "deploy": "wrangler deploy",
    "cf:types": "wrangler types",
    "data:transfer": "node scripts/transfer-data.mjs"
  },
  "dependencies": {
    "@farcaster/miniapp-sdk": "0.1.10",
    "@privy-io/react-auth": "3.48.1",
    "@xmtp/browser-sdk": "4.1.0",
    "@xmtp/content-type-text": "2.0.2",
    "date-fns": "4.4.0",
    "ethers": "6.15.0",
    "next-auth": "4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "siwe": "2.3.2",
    "viem": "2.56.5",
    "vinext": "1.1.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@cloudflare/vite-plugin": "1.63.1",
    "@electric-sql/pglite": "0.5.9",
    "@openzeppelin/contracts": "5.4.0",
    "@playwright/test": "1.55.1",
    "@types/node": "22.19.15",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "eslint": "8.57.0",
    "miniflare": "5.20261006.1-alpha",
    "next": "16.3.8",
    "pg": "8.16.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12 <23",
    "npm": "10.9.4"
  },
  "packageManager": "npm@10.9.4",
  "overrides": {
    "fflate": "0.7.5",
    "ws": "8.21.0",
    "jayson": {
      "ws": "7.5.13"
    },
    "@walletconnect/jsonrpc-ws-connection": {
      "ws": "7.5.13"
    },
    "@xmtp/proto": "3.90.0",
    "uuid@8.3.2": "11.1.1",
    "uuid@9.0.1": "11.1.1"
  }
}
