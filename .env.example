# W3RK's existing public Privy app ID is tracked in lib/privy.ts.
# It is browser configuration, not a secret or a required build environment value.
# Local-only secrets go in ignored .dev.vars, not this file or GitHub.
# NEXTAUTH_SECRET=<stable random value with at least 32 characters>
# NEXTAUTH_URL=http://localhost:5173
# AUTH_ALLOWED_CHAIN_IDS=8453,84532,1
# READ_ONLY=false
